---
import { tv, type VariantProps } from 'tailwind-variants';

const card = tv({
	variants: {
		color: {
			card: 'bg-card',
			fade: 'bg-fade',
		},
		size: {
			sm: 'rounded-lg p-4 shadow-sm',
			md: 'rounded-xl p-8 shadow-sm',
			lg: 'rounded-2xl p-12 shadow-sm',
		},
	},
	defaultVariants: {
		color: 'card',
	},
});

interface Props extends VariantProps<typeof card> {
	class?: string;
}

const { class: className, size, color } = Astro.props;
const classes = card({ class: className, size, color });
---

<div class={classes}><slot /></div>
