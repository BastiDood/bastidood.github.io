---
import BaseLayout from '#layout/index.astro';
import Card from '#components/card.astro';
import Hero from '#components/hero.astro';
import Proficiencies from '#features/portfolio/technologies/proficiencies.astro';
import ProjectCard from '#features/portfolio/project-card.astro';
import { getProjects } from '#features/portfolio/get-projects.ts';

const projects = await getProjects();
---

<BaseLayout
	title="Portfolio · Basti Ortiz"
	description="Selected software, systems, and open-source projects by Basti Ortiz."
>
	<Hero>
		<Proficiencies class="m-4 sm:m-12 md:m-16" />
	</Hero>
	<div class="m-4 mt-0! sm:m-12 md:m-16">
		<div class="prose prose-a:text-sky-600 prose-a:hover:underline prose-code:break-words prose-headings:mt-0 max-w-none space-y-8">
			<div class="block grid-cols-[auto_1fr] gap-4 lg:grid">
				<aside class="not-prose">
					<Card size="md" class="sticky top-20 hidden lg:block">
						<strong class="text-lg text-black">Table of Contents</strong>
						<ol class="text-md text-gray-500">
							{projects.map(project => (
								<li>
									<a href={`#${project.id}`}>{project.data.title}</a>
								</li>
							))}
						</ol>
					</Card>
				</aside>
				<article id="projects" class="space-y-8">
					{projects.map(project => (
						<ProjectCard {...project} />
					))}
				</article>
			</div>
		</div>
	</div>
</BaseLayout>
