---
import { getCollection } from 'astro:content';

import BaseLayout from '#layout/index.astro';
import Card from '#components/card.astro';
import Hero from '#components/hero.astro';
import SeriesCard from '#features/series/series-card.astro';
import { Icon } from 'astro-icon/components';

const seriesEntries = await getCollection('series');
const articles = await getCollection('articles');
seriesEntries.sort((left, right) => left.data.title.localeCompare(right.data.title));
---

<BaseLayout title="Article Series · Basti Ortiz" description="Browse Basti Ortiz's article series.">
	<Hero>
		<Card size="md" class="prose m-4 sm:m-12 md:m-16">
			<p>
				Some ideas need more than one article. These series organize related essays into
				focused paths through asynchronous JavaScript, software practices, cryptography, web
				fundamentals, learning resources, and hands-on technology reviews.
			</p>
			<a
				href="/series/rss.xml"
				class="bg-rss hover:bg-rss-hover ml-auto flex w-fit items-center gap-2 rounded-lg px-3 py-2 text-sm font-bold text-white no-underline shadow-sm transition-colors hover:no-underline"
			>
				<Icon name="simple-icons:rss" class="size-4" aria-hidden="true" />
				<span>Follow</span>
			</a>
		</Card>
	</Hero>
	<div class="mx-auto max-w-7xl p-4 sm:p-6">
		<div class="grid gap-6 md:grid-cols-2">
			{seriesEntries.map(entry => {
				const articleCount = articles.filter(
					article => article.data.series?.id === entry.id,
				).length;
				return <SeriesCard series={entry} articleCount={articleCount} />;
			})}
		</div>
	</div>
</BaseLayout>
