---
import { type CollectionEntry, getCollection, render } from 'astro:content';

import ArticleCard from '#features/articles/article-card.astro';
import BaseLayout from '#layout/index.astro';

export async function getStaticPaths() {
	const series = await getCollection('series');
	return series.map(entry => ({ params: { slug: entry.id }, props: entry }));
}

type Props = CollectionEntry<'series'>;

const series = Astro.props;
const { Content } = await render(series);
const articles = await getCollection('articles', article => article.data.series?.id === series.id);
articles.sort((left, right) => right.data.publishedAt.localeCompare(left.data.publishedAt));
---

<BaseLayout
	title={`${series.data.title} · Basti Ortiz`}
	description={`Articles in the ${series.data.title} series.`}
>
	<div class="mx-auto max-w-7xl space-y-8 p-4 sm:p-6">
		<header class="space-y-2">
			<p><a href="/series/">All Series</a></p><h1>
				{series.data.title}
			</h1><div class="prose text-lg text-gray-700"><Content /></div>
		</header>
		<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			{articles.map(article => <ArticleCard {...article} />)}
		</div>
	</div>
</BaseLayout>
