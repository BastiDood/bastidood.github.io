---
import { getCollection } from 'astro:content';

import ArticleCard from '#features/articles/article-card.astro';
import BaseLayout from '#layout/index.astro';
import Card from '#components/card.astro';
import Hero from '#components/hero.astro';
import { Icon } from 'astro-icon/components';

const articles = await getCollection('articles');
articles.sort((left, right) => {
	const leftFeaturedAt = left.data.featuredAt;
	const rightFeaturedAt = right.data.featuredAt;

	if (typeof leftFeaturedAt === 'undefined' && typeof rightFeaturedAt !== 'undefined') return 1;
	if (typeof leftFeaturedAt !== 'undefined' && typeof rightFeaturedAt === 'undefined') return -1;

	if (typeof leftFeaturedAt !== 'undefined' && typeof rightFeaturedAt !== 'undefined') {
		const featuredOrder = rightFeaturedAt.getTime() - leftFeaturedAt.getTime();
		if (featuredOrder !== 0) return featuredOrder;
	}

	return right.data.publishedAt.getTime() - left.data.publishedAt.getTime();
});

const { remaining, featured } = Object.groupBy(articles, article =>
	typeof article.data.featuredAt === 'undefined' ? 'remaining' : 'featured',
);
---

<BaseLayout
	title="Articles · Basti Ortiz"
	description="Articles by Basti Ortiz about software engineering, programming languages, and building dependable systems."
>
	<Hero>
		<Card size="md" class="prose m-4 sm:m-12 md:m-16">
			<p>
				I write about software architecture, programming languages, performance,
				asynchronous JavaScript, web development, security, developer experience, open
				source, and the practical craft of building reliable systems—including how AI and
				coding agents are changing that work.
			</p>
			<a
				href="/articles/rss.xml"
				class="bg-rss hover:bg-rss-hover ml-auto flex w-fit items-center gap-2 rounded-lg px-3 py-2 text-sm font-bold text-white no-underline shadow-sm transition-colors hover:no-underline"
			>
				<Icon name="simple-icons:rss" class="size-4" aria-hidden="true" />
				<span>Follow</span>
			</a>
		</Card>
	</Hero>
	<div class="m-4 mt-0! max-w-7xl space-y-12 sm:m-12 md:m-16 xl:mx-auto">
		{typeof featured === 'undefined' ? null : (
			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				{featured.map(article => (
					<ArticleCard {...article} />
				))}
			</div>
		)}
		{typeof remaining === 'undefined' ? null : (
			<section aria-labelledby="more-articles" class="space-y-5">
				<h2 id="more-articles">More Articles</h2>
				<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
					{remaining.map(article => (
						<ArticleCard {...article} />
					))}
				</div>
			</section>
		)}
	</div>
</BaseLayout>
