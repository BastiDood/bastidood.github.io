---
import { getCollection, getEntries } from 'astro:content';

import ArticleCard from '#features/articles/article-card.astro';
import BaseLayout from '#layout/index.astro';
import Card from '#components/card.astro';
import Hero from '#components/hero.astro';

const articles = await getCollection('articles');
articles.sort((left, right) => right.data.publishedAt.localeCompare(left.data.publishedAt));
const featured = await getEntries([
	{ collection: 'articles', id: 'unlocking-agentic-workflows' },
	{ collection: 'articles', id: 'vertically-sliced-coding-agents' },
	{ collection: 'articles', id: 'course-cast-optimization' },
	{ collection: 'articles', id: 'vertically-sliced-architectures' },
	{ collection: 'articles', id: 'async-constructors' },
	{ collection: 'articles', id: 'sequential-trap' },
]);
---

<BaseLayout
	title="Articles · Basti Ortiz"
	description="Articles by Basti Ortiz about software engineering, programming languages, and building dependable systems."
>
	<Hero>
		<Card size="md" class="prose m-4 sm:m-12 md:m-16">
			<p>
				I write about software architecture, programming languages, performance,
				asynchronous JavaScript, web development, security, developer experience, open
				source, and the practical craft of building reliable systems—including how AI and
				coding agents are changing that work.
			</p>
		</Card>
	</Hero>
	<div class="m-4 mt-0! max-w-7xl space-y-12 sm:m-12 md:m-16 xl:mx-auto">
		<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			{featured.map(article => <ArticleCard {...article} />)}
		</div>
		<section aria-labelledby="all-articles" class="space-y-5">
			<h2 id="all-articles">All Articles</h2>
			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				{articles.map(article => <ArticleCard {...article} />)}
			</div>
		</section>
	</div>
</BaseLayout>
