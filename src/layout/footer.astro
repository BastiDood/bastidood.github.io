---
import profile from '#branding/profile.svg';
---

<footer class="bg-gray-800 p-4 text-gray-400 sm:p-6">
	<div class="mx-auto max-w-7xl">
		<div class="gap-8 md:flex md:items-start md:justify-between">
			<a href="/" class="mb-6 flex items-center hover:no-underline md:mb-0">
				<img
					src={profile.src}
					alt=""
					width="32"
					height="32"
					loading="lazy"
					class="mr-3 size-8"
				/>
				<span class="self-center text-2xl font-semibold whitespace-nowrap text-white">
					Basti Ortiz
				</span>
			</a>
			<div class="grid grid-cols-2 gap-8 sm:grid-cols-4 sm:gap-6 [&_a]:text-white/60 [&_a]:hover:text-white">
				<section>
					<h2 class="mb-4 text-sm font-semibold text-white uppercase">Sitemap</h2>
					<ul class="space-y-2">
						<li>
							<a href="/">Home</a>
						</li>
						<li>
							<a href="/portfolio/">Portfolio</a>
						</li>
						<li>
							<a href="/articles/">Articles</a>
						</li>
						<li>
							<a href="/series/">Series</a>
						</li>
					</ul>
				</section>
				<section>
					<h2 class="mb-4 text-sm font-semibold text-white uppercase">Social</h2>
					<ul class="space-y-2">
						<li>
							<a href="https://dev.to/somedood" target="_blank">
								DEV
							</a>
						</li>
						<li>
							<a href="https://www.linkedin.com/in/basti-ortiz/" target="_blank">
								LinkedIn
							</a>
						</li>
						<li>
							<a href="https://twitter.com/BastiDood" target="_blank">
								Twitter
							</a>
						</li>
						<li>
							<a href="https://bsky.app/profile/bastidood.dev" target="_blank">
								Bluesky
							</a>
						</li>
						<li>
							<a href="https://github.com/BastiDood" target="_blank">
								GitHub
							</a>
						</li>
					</ul>
				</section>
				<section>
					<h2 class="mb-4 text-sm font-semibold text-white uppercase">Code</h2>
					<ul class="space-y-2">
						<li>
							<a
								href="https://github.com/BastiDood/bastidood.github.io"
								target="_blank"
							>
								Repository
							</a>
						</li>
						<li>
							<a
								href="https://github.com/BastiDood/bastidood.github.io/blob/main/COPYING.md"
								target="_blank"
							>
								External Assets
							</a>
						</li>
					</ul>
				</section>
				<section>
					<h2 class="mb-4 text-sm font-semibold text-white uppercase">Feeds</h2>
					<ul class="space-y-2">
						<li>
							<a href="/rss.xml">Milestones</a>
						</li>
						<li>
							<a href="/articles/rss.xml">Articles</a>
						</li>
						<li>
							<a href="/series/rss.xml">Series</a>
						</li>
						<li>
							<a href="/portfolio/rss.xml">Portfolio</a>
						</li>
						<li>
							<a href="/sitemap-index.xml">Sitemap</a>
						</li>
					</ul>
				</section>
			</div>
		</div>
		<hr class="my-6 border-gray-700" />
		<p class="text-sm">
			&copy; {new Date().getFullYear()}
			<a href="/">Basti Ortiz</a>. All rights reserved.
		</p>
	</div>
</footer>
