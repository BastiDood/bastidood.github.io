---
import { ClientRouter } from 'astro:transitions';

import favicon from '#branding/profile.png';

import './global.css';
import Footer from './footer.astro';
import Navbar from './navbar.astro';
import type { OpenGraphImage } from './open-graph.ts';

import DEFAULT_OPEN_GRAPH_IMAGE from './assets/open-graph.webp';

interface SharedProps {
	title?: string;
	description?: string;
	canonical?: URL;
	openGraphTitle?: string;
	openGraphImage?: OpenGraphImage | undefined;
}

interface WebsiteProps extends SharedProps {
	openGraphType?: 'website';
	profileFirstName?: never;
	profileLastName?: never;
	profileUsername?: never;
	author?: never;
	publishedAt?: never;
	updatedAt?: never;
	tags?: never;
}

interface ArticleProps extends SharedProps {
	openGraphType: 'article';
	profileFirstName?: never;
	profileLastName?: never;
	profileUsername?: never;
	author: URL;
	publishedAt: Date;
	updatedAt?: Date | undefined;
	tags: string[];
}

interface ProfileProps extends SharedProps {
	openGraphType: 'profile';
	profileFirstName: string;
	profileLastName: string;
	profileUsername: string;
	author?: never;
	publishedAt?: never;
	updatedAt?: never;
	tags?: never;
}

type Props = WebsiteProps | ArticleProps | ProfileProps;

const DEFAULT_OPEN_GRAPH_IMAGE_METADATA: OpenGraphImage = {
	url: new URL(DEFAULT_OPEN_GRAPH_IMAGE.src, Astro.site),
	mimeType: 'image/webp',
	width: DEFAULT_OPEN_GRAPH_IMAGE.width,
	height: DEFAULT_OPEN_GRAPH_IMAGE.height,
	alt: 'Basti Ortiz, web developer, with Rust, TypeScript, JavaScript, Python, Deno, HTML, CSS, and Node.js logos',
};

const {
	title = 'Basti Ortiz',
	description = 'Web developer, open-source contributor, learner, writer, mentor, and leader.',
	canonical = new URL(Astro.url.pathname, Astro.site),
	openGraphTitle = title,
	openGraphImage = DEFAULT_OPEN_GRAPH_IMAGE_METADATA,
	openGraphType = 'website',
	profileFirstName,
	profileLastName,
	profileUsername,
	author,
	publishedAt,
	updatedAt,
	tags = [],
} = Astro.props;
---

<!doctype html>
<html
	lang="en"
	prefix="og: https://ogp.me/ns# article: https://ogp.me/ns/article# profile: https://ogp.me/ns/profile#"
	class="scroll-smooth"
>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" href={favicon.src} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" type="application/rss+xml" title="Milestones" href="/rss.xml" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Articles"
			href="/articles/rss.xml"
		/>
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Article Series"
			href="/series/rss.xml"
		/>
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Portfolio"
			href="/portfolio/rss.xml"
		/>
		<title>{title}</title>
		<meta property="og:site_name" content="Basti Ortiz" />
		<meta property="og:title" content={openGraphTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={openGraphType} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={openGraphImage.url} />
		<meta property="og:image:type" content={openGraphImage.mimeType} />
		<meta property="og:image:width" content={openGraphImage.width.toString()} />
		<meta property="og:image:height" content={openGraphImage.height.toString()} />
		<meta property="og:image:alt" content={openGraphImage.alt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@BastiDood" />
		<meta name="twitter:title" content={openGraphTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={openGraphImage.url} />
		<meta name="twitter:image:alt" content={openGraphImage.alt} />
		{typeof author === 'undefined' ? null : (
			<>
				<meta property="article:author" content={author} />
				<meta name="twitter:creator" content="@BastiDood" />
			</>
		)}
		{typeof publishedAt === 'undefined' ? null : (
			<meta property="article:published_time" content={publishedAt.toISOString()} />
		)}
		{typeof updatedAt === 'undefined' ? null : (
			<meta property="article:modified_time" content={updatedAt.toISOString()} />
		)}
		{tags.map(tag => (
			<meta property="article:tag" content={tag} />
		))}
		{typeof profileFirstName === 'undefined' ? null : (
			<>
				<meta property="profile:first_name" content={profileFirstName} />
				<meta property="profile:last_name" content={profileLastName} />
				<meta property="profile:username" content={profileUsername} />
			</>
		)}
		<ClientRouter />
	</head>
	<body>
		<a href="#main-content" class="sr-only focus:not-sr-only">
			Skip to Content
		</a>
		<Navbar />
		<main id="main-content" class="min-h-[calc(100vh-4rem)]">
			<slot />
		</main>
		<Footer />
		<script>
			import { PUBLIC_POSTHOG_API_KEY } from 'astro:env/client';
			import posthog from 'posthog-js';

			if (
				import.meta.env.PROD &&
				typeof PUBLIC_POSTHOG_API_KEY !== 'undefined' &&
				PUBLIC_POSTHOG_API_KEY !== ''
			)
				posthog.init(PUBLIC_POSTHOG_API_KEY, {
					api_host: 'https://us.i.posthog.com',
					defaults: '2026-05-30',
					capture_pageview: 'history_change',
					person_profiles: 'never',
				});
		</script>
	</body>
</html>
