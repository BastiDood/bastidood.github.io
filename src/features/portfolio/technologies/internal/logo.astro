---
import OptimizedPicture from '#components/optimized-picture.astro';
import { Icon } from 'astro-icon/components';

import type { TechnologyLogo } from './catalog.ts';

interface Props {
	logo: TechnologyLogo;
}

const { logo } = Astro.props;
---

{logo.kind === 'icon' ? (
	<Icon
		name={logo.icon}
		title={logo.label}
		role="img"
		class="h-10 w-auto max-w-16"
		style={typeof logo.color === 'undefined' ? null : `color: ${logo.color}`}
	/>
) : (
	<OptimizedPicture
		src={logo.source}
		alt={logo.label}
		title={logo.label}
		class="h-10 w-auto max-w-16"
		loading="lazy"
		decoding="async"
	/>
)}
