---
import Card from '#components/card.astro';
import { cn } from 'cn';
import { tv } from 'tailwind-variants';

import TechnologyLogo from './internal/logo.astro';
import { proficiencyGroups } from './internal/catalog.ts';

interface Props {
	class?: string;
}

const logoList = tv({
	base: 'not-prose flex list-none flex-wrap items-center justify-center p-0',
	variants: {
		group: {
			Languages: 'gap-3',
			Technologies: 'gap-3',
			'Libraries & Frameworks': 'gap-x-3 gap-y-4',
		},
	},
});

const { class: className } = Astro.props;
---

<article class={cn('grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3', className)}>
	{
		proficiencyGroups.map(group => (
			<Card size="md" class="prose">
				<h2>{group.title}</h2>
				<ul class={logoList({ group: group.title })}>
					{group.logos.map(logo => (
						<li>
							<TechnologyLogo logo={logo} />
						</li>
					))}
				</ul>
			</Card>
		))
	}
</article>
