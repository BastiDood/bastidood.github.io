---
import type { ImageMetadata } from 'astro';

interface Props {
	source: ImageMetadata;
	alt: string;
	class?: string;
}

const { source, alt, class: className } = Astro.props;
---

<img
	src={source.src}
	alt={alt}
	class={className}
	width={source.width}
	height={source.height}
	loading="lazy"
	decoding="async"
/>
