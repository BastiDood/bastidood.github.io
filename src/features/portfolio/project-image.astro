---
import { cn } from 'cn';

import type { ImageMetadata } from 'astro';

interface Props {
	source: ImageMetadata;
	alt: string;
	class?: string;
}

const { source, alt, class: className } = Astro.props;
---

<img
	src={source.src}
	alt={alt}
	class={cn('h-auto max-w-full object-contain', className)}
	width={source.width}
	height={source.height}
	loading="lazy"
	decoding="async"
/>
