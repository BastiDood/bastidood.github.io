---
import { type CollectionEntry, render } from 'astro:content';

import Card from '#components/card.astro';
import { projectTechnologyLogos } from '#technology-catalog/technology-catalog.ts';

import ProjectImage from './project-image.astro';

type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { Content } = await render(project);
const technologies = project.data.technologies.map(
	technology => projectTechnologyLogos[technology],
);
---

<section id={project.id} class="scroll-mt-20">
	<Card size="md">
		<h2>{project.data.title}</h2>
		<div class="not-prose flex flex-wrap items-center gap-2">
			{
				typeof project.data.logo === 'undefined' ? null : (
					<ProjectImage
						source={project.data.logo.src}
						alt={project.data.logo.alt ?? ''}
						class="h-10 w-auto max-w-16 object-contain"
					/>
				)
			}
			{
				technologies.map(technology => (
					<img
						src={technology.source.src}
						alt={technology.label}
						title={technology.label}
						class="h-10 max-w-16"
						loading="lazy"
					/>
				))
			}
		</div>
		<div class="contents"><Content /></div>
	</Card>
</section>
