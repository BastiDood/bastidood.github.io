---
import { type CollectionEntry, render } from 'astro:content';

import Card from '#components/card.astro';

import ProjectImage from './project-image.astro';

import ProjectTechnologies from './technologies/project-list.astro';

type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { Content } = await render(project);
---

<section id={project.id} class="scroll-mt-20">
	<Card size="md">
		<h2>{project.data.title}</h2>
		<div class="not-prose flex flex-wrap items-center gap-2">
			{typeof project.data.logo === 'undefined' ? null : (
				<ProjectImage
					source={project.data.logo.src}
					alt={project.data.logo.alt ?? ''}
					class="h-10 w-auto max-w-16 object-contain"
				/>
			)}
			<ProjectTechnologies technologies={project.data.technologies} />
		</div>
		<div class="contents">
			<Content />
		</div>
	</Card>
</section>
