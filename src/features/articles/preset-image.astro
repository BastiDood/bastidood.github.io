---
import OptimizedPicture from '#components/optimized-picture.astro';
import type { ImageMetadata } from 'astro';

import { type ImagePresetName, imagePresets } from './image-presets.ts';

interface Props {
	source: ImageMetadata;
	preset: ImagePresetName;
	alt: string;
	class?: string;
	loading?: 'eager' | 'lazy';
	decoding?: 'async' | 'auto' | 'sync';
	fetchPriority?: 'auto' | 'high' | 'low';
}

const {
	source,
	preset,
	alt,
	class: className,
	loading = 'lazy',
	decoding = 'async',
	fetchPriority = 'auto',
} = Astro.props;
const definition = imagePresets[preset];
---

<OptimizedPicture
	src={source}
	alt={alt}
	class={className}
	width={definition.width}
	height={definition.height}
	fit={definition.fit}
	position={definition.position}
	widths={definition.widths}
	sizes={definition.sizes}
	loading={loading}
	decoding={decoding}
	fetchpriority={fetchPriority}
/>
